일단 파이썬으로 append pop해보기


def solution(arr, flag):
    answer = []
    for i in range(len(arr)):
        if flag[i] == True:
            answer.append(arr[i])
            answer.append(arr[i])
        else:
            for _ in range(arr[i]):
                answer.pop()
    return answer

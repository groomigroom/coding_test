def findInsertIdx (array, data):
    findIdx = -1
    for i in range(0, len(array)):
        if (array[i] > data):
            findIdx = i
            break

    if (findIdx == -1):
        return len(array)
    else:
        return findIdx

    

    
testArray = [];

insPos = findInsertIdx(testArray, 55);
print(insPos); # 출력: 0

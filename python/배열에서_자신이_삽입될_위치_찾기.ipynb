def findInsertIdx (array, data):
    findIdx = -1
    for i in range(0, len(array)):
        if (array[i] > data):
            findIdx = i
            break

    if (findIdx == -1) {
      return array.length;
      } else {
        return findIdx;
    }

    

    
let testArray = [];

let insPos = findInsertIdx(testArray, 55);
console.log(insPos); // 출력: 0
